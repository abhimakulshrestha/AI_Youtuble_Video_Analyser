{
  "manifest_version": 3,
  "name": "YouTube AI Analyzer",
  "version": "1.0.0",
  "description": "Analyze YouTube videos with Groq Qwen.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Analyzer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_end"
    }
  ]
}
